# --- NocoDB ---
# Base URL of your NocoDB, no trailing slash
NOCODB_URL=https://nocodb.yourdomain.com
# API token (Account > Tokens). Stays on the server, never sent to the browser.
NOCODB_TOKEN=
# Base id of the CSJ base (from the n8n output: base_id)
NOCODB_BASE_ID=pfchnhvc1sa838q

# --- Sessions ---
# Long random string (at least 32 chars). Generate with: openssl rand -base64 48
SESSION_SECRET=
# Session length in hours
SESSION_HOURS=12

# --- First admin (only used while the Portal Users table is empty) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Portal Admin

# --- Misc ---
# Timezone used for "today" on the dashboard
APP_TIMEZONE=America/Detroit
